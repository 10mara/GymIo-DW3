{
  "name": "gymio-backend",
  "version": "2.0.0",
  "description": "Backend do GymIO - PostgreSQL + Drizzle ORM",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
	"start": "node server.js",
	"dev": "nodemon server.js",
	"db:check": "node scripts/check-db.js",
	"db:generate": "drizzle-kit generate --config=drizzle.config.js",
	"db:migrate": "drizzle-kit migrate --config=drizzle.config.js",
	"db:push": "drizzle-kit push --config=drizzle.config.js",
	"db:studio": "drizzle-kit studio --config=drizzle.config.js",
	"db:check-schema": "drizzle-kit check --config=drizzle.config.js"
	},
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "nodemon": "^2.0.22"
  }
}